{
    "name": "threejs-experiments",
    "version": "0.0.0",
    "private": true,
    "license": "(MIT or CC0 1.0)",
    "scripts": {
        "build": "virmator frontend build",
        "compile": "virmator compile",
        "format": "virmator format",
        "publish": "virmator publish \"npm run compile && npm run test:all\"",
        "start": "npm install && virmator frontend",
        "test:all": "concurrently --colors --kill-others-on-fail -c auto --names types,spelling,format,deps,build \"npm run test:types\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:deps\" \"npm run build\"",
        "test:deps": "virmator deps check",
        "test:format": "virmator format check",
        "test:spelling": "virmator spellcheck",
        "test:types": "tsc --noEmit"
    },
    "dependencies": {
        "@augment-vir/common": "^26.3.2",
        "element-vir": "^22.1.1",
        "run-time-assertions": "^1.2.0",
        "spa-router-vir": "^4.0.1",
        "three": "^0.163.0",
        "type-fest": "^4.15.0",
        "typed-event-target": "^3.3.0"
    },
    "devDependencies": {
        "@augment-vir/node-js": "^26.3.2",
        "@open-wc/testing": "^4.0.0",
        "@types/three": "^0.163.0",
        "cspell": "^8.7.0",
        "dependency-cruiser": "^16.3.1",
        "esbuild": "^0.20.2",
        "npm-check-updates": "~16.12.3",
        "prettier": "^3.2.5",
        "prettier-plugin-interpolated-html-tags": "^1.0.5",
        "prettier-plugin-jsdoc": "^1.3.0",
        "prettier-plugin-multiline-arrays": "^3.0.4",
        "prettier-plugin-organize-imports": "^3.2.4",
        "prettier-plugin-packagejson": "^2.5.0",
        "prettier-plugin-sort-json": "^4.0.0",
        "prettier-plugin-toml": "^2.0.1",
        "rollup-plugin-visualizer": "^5.12.0",
        "typescript": "^5.3.3",
        "virmator": "^11.5.2",
        "vite": "^4.5.3",
        "vite-tsconfig-paths": "^4.3.2"
    }
}
